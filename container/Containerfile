# Where kiwi-app is built on the development PC (Fedora Atomic: no SDKs on the host).
# container/gradlew builds this image once and runs ./gradlew in it.
#
#   --target jdk   only a JDK and age: enough for ./gradlew :core:test
#   (the default)  with the Android SDK: ./gradlew assembleDebug lint test
#
# The JDK is the one CI builds with (.github/workflows/build.yml).
FROM docker.io/library/eclipse-temurin:21-jdk AS jdk

RUN apt-get update \
    && apt-get install -y --no-install-recommends age unzip curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV GRADLE_USER_HOME=/gradle
WORKDIR /src

FROM jdk AS android

# Google's command-line tools, by the checksum its package index gives, then what the app is
# compiled against. Installing it accepts the Android SDK licence.
ARG CMDLINE_TOOLS=commandlinetools-linux-16111833_latest.zip
ARG CMDLINE_TOOLS_SHA1=e025545c62a8e64c7559119566a569fb1dec5f60
ENV ANDROID_HOME=/opt/android-sdk
RUN mkdir -p $ANDROID_HOME/cmdline-tools \
    && curl -fsSL -o /tmp/tools.zip https://dl.google.com/android/repository/$CMDLINE_TOOLS \
    && echo "$CMDLINE_TOOLS_SHA1  /tmp/tools.zip" | sha1sum -c - \
    && unzip -q /tmp/tools.zip -d $ANDROID_HOME/cmdline-tools \
    && mv $ANDROID_HOME/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest \
    && rm /tmp/tools.zip \
    && yes | $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses > /dev/null \
    && $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager "platforms;android-37.0" "build-tools;36.0.0" "platform-tools" \
    && rm -rf /root/.android
